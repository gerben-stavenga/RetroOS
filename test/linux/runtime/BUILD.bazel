load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//toolchain:musl_transition.bzl", "musl64_binary")

package(default_visibility = ["//tests:__pkg__"])

rust_binary(
    name = "runtime_bin",
    srcs = ["src/main.rs"],
    edition = "2024",
    rustc_flags = ["-Cstrip=symbols", "-Clinker-flavor=ld.lld", "-Clinker=rust-lld", "-Crelocation-model=static"],
)

musl64_binary(
    name = "runtime",
    binary = ":runtime_bin",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "keyboard_bin", srcs = ["src/keyboard.rs"], edition = "2024",
    rustc_flags = ["-Cstrip=symbols", "-Clinker-flavor=ld.lld", "-Clinker=rust-lld", "-Crelocation-model=static"],
)
musl64_binary(name = "keyboard", binary = ":keyboard_bin", visibility = ["//visibility:public"])
