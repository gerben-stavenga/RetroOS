
package(default_visibility = ["//tests:__pkg__"])
genrule(
    name = "vga_text_com",
    srcs = ["vga_text.asm"],
    outs = ["VGATEXT.COM"],
    cmd = "nasm -f bin -o $@ $<",
    visibility = ["//visibility:public"],
)
genrule(
    name = "svgaprobe_com",
    srcs = ["svgaprobe.asm"],
    outs = ["SVGAPROBE.COM"],
    cmd = "nasm -f bin -o $@ $<",
    visibility = ["//visibility:public"],
)

genrule(
    name = "vbe_pm_com",
    srcs = ["vbe_pm.asm"],
    outs = ["VBEPM.COM"],
    cmd = "nasm -f bin -o $@ $<",
    visibility = ["//visibility:public"],
)

genrule(
    name = "vbe_pm_visual_com",
    srcs = ["vbe_pm.asm"],
    outs = ["VBEVIS.COM"],
    cmd = "nasm -D VBE_VISUAL=1 -f bin -o $@ $<",
    visibility = ["//visibility:public"],
)
