+
+    /// Unlinks a regular file while retaining its cluster chain in the returned file.
+    ///
+    /// All other handles to this entry must be closed first. The caller must
+    /// seek to zero and truncate the returned file to reclaim its clusters.
+    /// Use on volatile volumes only, since a crash can leave clusters orphaned.
+    pub fn unlink_file(&self, path: &str) -> Result<File<'a, IO, TP, OCC>, Error<IO::Error>> {
+        let (name, rest_opt) = split_path(path);
+        if let Some(rest) = rest_opt {
+            let dir = self.find_entry(name, Some(true), None)?.to_dir();
+            return dir.unlink_file(rest);
+        }
+        let entry = self.find_entry(name, Some(false), None)?;
+        self.remove_entry(&entry)?;
+        Ok(entry.to_unlinked_file())
+    }
+
+    fn remove_entry(&self, e: &DirEntry<IO, TP, OCC>) -> Result<(), Error<IO::Error>> {
         // free long and short name entries
         let mut stream = self.stream.clone();
         stream.seek(SeekFrom::Start(e.offset_range.0))?;
