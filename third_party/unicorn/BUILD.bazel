load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

# The Unicorn C core (the patched fork pinned in MODULE.bazel), built as a
# first-class Bazel target with the configured host CC toolchain — this is
# what unicorn-engine-sys's build.rs used to do via the `cmake` crate. The
# sys crate's build script is disabled (gen_build_script in MODULE.bazel);
# its bindings are vendored (toolchain/unicorn-sys-pregen-bindings.patch)
# and the crate links this target via an annotation dep.
#
# x86 only: RetroOS interprets x86 guests; the crate's default features
# built every arch core (sparc, mips, tricore, …) for nothing.
cmake(
    name = "unicorn",
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        # Unicorn vendors QEMU's glib shim, and `glib_compat/goption.c`
        # declares fields named `bool`. That is legal C17 and a syntax error
        # in C23, which GCC 15 (Arch, Fedora 42) selects by default — so pin
        # the standard for this build rather than asking every packager on a
        # new toolchain to pass --repo_env=BAZEL_CONLYOPTS=-std=gnu17.
        "CMAKE_C_FLAGS": "-std=gnu17",
        "UNICORN_ARCH": "x86",
        "UNICORN_BUILD_TESTS": "OFF",
        "UNICORN_INSTALL": "ON",
        # The all-in-one libunicorn.a (v1-style archive) — what the sys
        # crate's `cargo:rustc-link-lib=static=unicorn` expects.
        "UNICORN_LEGACY_STATIC_ARCHIVE": "ON",
    },
    lib_source = "@unicorn_fork//:srcs",
    # QEMU's softmmu emits 128-bit guest atomics (`helper_atomic_cmpxchgo_*`
    # in cputlb.c). GCC does not inline those on x86-64 -- `cmpxchg16b` is not
    # in the baseline ISA -- so the archive carries an undefined reference to
    # `__atomic_compare_exchange_16`, which lives in libatomic. Rust links
    # with -nodefaultlibs and an explicit library list, so nothing pulls it in
    # implicitly; say so here, once, where every consumer of the archive
    # inherits it. (A toolchain with cx16 enabled inlines the helper and never
    # needs the library, which is why this only bites on some hosts.)
    linkopts = ["-latomic"],
    out_static_libs = ["libunicorn.a"],
    visibility = ["//visibility:public"],
)
