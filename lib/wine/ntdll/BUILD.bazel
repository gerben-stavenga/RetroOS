package(default_visibility = ["//visibility:public"])

genrule(
    name = "ntdll_dll",
    srcs = ["@wine_freetype_tar//file", "//lib/wine:build_freetype.py", "//lib/wine:font_mapping.c", "@wine_source_tar//file", "//lib/wine:win32u-pe.patch", "//lib/wine:graphics.c", "//lib/wine:waveform-driver.c"],
    tools = ["//lib/wine:build_ntdll.py", "@wine_build_tools//:usr/bin/flex"],
    outs = ["NTDLL.DLL", "backend-abi.json", "KRNL386.EXE16", "WIN32U.DLL", "KERNELBASE.DLL", "KERNEL32.DLL", "WS2_32.DLL", "WINED3D.DLL", "WINMM.DLL", "MMSYSTEM.DLL16"],
    cmd = "python3 $(location //lib/wine:build_ntdll.py) " +
          "--source $(location @wine_source_tar//file) --freetype $(location @wine_freetype_tar//file) " +
          "--flex $(location @wine_build_tools//:usr/bin/flex) " +
          "--output $(location NTDLL.DLL) --abi $(location backend-abi.json) " +
          "--mmsystem $(location MMSYSTEM.DLL16) --wave-driver $(location //lib/wine:waveform-driver.c) --winmm $(location WINMM.DLL) --wined3d $(location WINED3D.DLL) --winsock $(location WS2_32.DLL) --kernel16 $(location KRNL386.EXE16) --kernelbase $(location KERNELBASE.DLL) --kernel32 $(location KERNEL32.DLL) " +
          "--graphics-driver $(location //lib/wine:graphics.c) --graphics $(location WIN32U.DLL) --graphics-patch $(location //lib/wine:win32u-pe.patch)",
)
