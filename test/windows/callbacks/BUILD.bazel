    srcs = ["wine_keyboard.c", "build_wine_keyboard.py", "@wine_source//:headers", "@wine_source//:include/windef.h"],
    outs = ["wine_keyboard.exe"],
    cmd = "python3 $(location build_wine_keyboard.py) $(location wine_keyboard.c) $(location @wine_source//:include/windef.h) $@",
    visibility = ["//visibility:public"],
)

