load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load(":compatibility_images.bzl", "compatibility_image")

package(default_visibility = ["//visibility:public"])

# A portable, synchronous ext2/3/4 engine.  It deliberately has no dependency
# on RetroOS, libc, an executor, or a particular block layer.
rust_library(
    name = "ext4",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "portable_ext4",
    edition = "2024",
    rustc_flags = [
        "-Cpanic=abort",
        "-Crelocation-model=static",
    ],
    deps = ["@crc//:crc"],
)

rust_test(
    name = "ext4_test",
    crate = ":ext4",
    rustc_flags = [
        "-Cpanic=abort",
        "-Zpanic_abort_tests",
        "-Crelocation-model=static",
    ],
)

# An independently generated modern image catches mistakes that a synthetic
# fixture could accidentally share with the parser. Keep the journal clean;
# current mke2fs defaults, including orphan_file, are part of the corpus.
genrule(
    name = "modern_image",
    srcs = ["testdata/hello.txt"],
    outs = ["modern.img"],
    cmd = """
set -eu
ROOT="$(@D)/modern-image-root"
mkdir -p "$$ROOT/dir"
mkdir -p "$$ROOT/root-empty-dir"
mkdir -p "$$ROOT/replace-dir"
truncate -s 0 "$$ROOT/replace-dir/victim.bin"
mkdir -p "$$ROOT/move-left/branch" "$$ROOT/move-right"
cp $(location testdata/hello.txt) "$$ROOT/dir/hello.txt"
cp $(location testdata/hello.txt) "$$ROOT/root-data.bin"
truncate -s 0 "$$ROOT/dir/empty.bin"
truncate -s 0 "$$ROOT/root-empty.bin"
ln -s hello.txt "$$ROOT/dir/hello.link"
ln -s dir "$$ROOT/dir.link"
i=0
while [ "$$i" -lt 300 ]; do
  cp $(location testdata/hello.txt) "$$ROOT/dir/file-$$i"
  i=$$((i + 1))
done
truncate -s 16M "$@"
/usr/sbin/mkfs.ext4 -q -F -d "$$ROOT" "$@"
/usr/sbin/e2fsck -fyD "$@" >/dev/null
""",
)

# A compact four-group image. Population leaves two group-0 data blocks free
# while group 1 retains BLOCK_UNINIT, so a three-block allocation must both
# cross the group boundary and materialize group 1's implicit bitmap.
genrule(
    name = "multi_group_image",
    outs = ["multi-group.img"],
    cmd = """
set -eu
ROOT="$(@D)/multi-group-image-root"
mkdir -p "$$ROOT"
dd if=/dev/zero bs=4096 count=687 status=none | tr '\\000' x > "$$ROOT/filler.bin"
truncate -s 0 "$$ROOT/target.bin"
truncate -s 16M "$@"
/usr/sbin/mkfs.ext4 -q -F -b 4096 -g 1024 -d "$$ROOT" "$@"
""",
)

# Exhaust group 0's inode bitmap while leaving group 1 lazily initialized.
# Creating one more file must materialize both of group 1's implicit bitmaps.
genrule(
    name = "inode_group_image",
    outs = ["inode-group.img"],
    cmd = """
set -eu
ROOT="$(@D)/inode-group-image-root"
mkdir -p "$$ROOT/create" "$$ROOT/bulk"
i=0
while [ "$$i" -lt 1011 ]; do
  truncate -s 0 "$$ROOT/bulk/f-$$i"
  i=$$((i + 1))
done
truncate -s 16M "$@"
/usr/sbin/mkfs.ext4 -q -F -b 4096 -g 1024 -d "$$ROOT" "$@"
""",
)

genrule(
    name = "linear_directory_image",
    outs = ["linear-directory.img"],
    cmd = """
set -eu
ROOT="$(@D)/linear-directory-image-root"
mkdir -p "$$ROOT/linear"
i=0
while [ "$$i" -lt 500 ]; do
  printf x > "$$ROOT/linear/file-$$i"
  i=$$((i + 1))
done
truncate -s 0 "$$ROOT/linear/empty.bin"
truncate -s 32M "$@"
/usr/sbin/mkfs.ext4 -q -F -b 4096 -O ^dir_index -d "$$ROOT" "$@"
""",
)

# Sparse namespace and unwritten extent records generated by e2fsprogs. The
# latter cannot be produced by mkfs -d alone, so debugfs performs the same
# fallocate operation an ext4 user would request from the mounted filesystem.
genrule(
    name = "extent_mutation_image",
    outs = ["extent-mutation.img"],
    cmd = """
set -eu
ROOT="$(@D)/extent-mutation-root"
mkdir -p "$$ROOT"
truncate -s 65536 "$$ROOT/sparse.bin"
printf sparse-tail | dd of="$$ROOT/sparse.bin" bs=1 seek=60000 conv=notrunc status=none
truncate -s 32M "$@"
/usr/sbin/mkfs.ext4 -q -F -b 4096 -d "$$ROOT" "$@"
/usr/sbin/debugfs -w -R "write /dev/null unwritten.bin" "$@" >/dev/null 2>&1
/usr/sbin/debugfs -w -R "fallocate unwritten.bin 0 7" "$@" >/dev/null 2>&1
/usr/sbin/debugfs -w -R "sif unwritten.bin size 32768" "$@" >/dev/null 2>&1
/usr/sbin/e2fsck -fy "$@" >/dev/null
""",
)

rust_test(
    name = "modern_image_test",
    srcs = ["tests/modern_image.rs"],
    crate_name = "modern_image_test",
    data = [
        ":extent_mutation_image",
        ":inode_group_image",
        ":linear_directory_image",
        ":modern_image",
        ":multi_group_image",
    ],
    edition = "2024",
    rustc_env = {
        "EXT4_MODERN_IMAGE": "$(rlocationpath :modern_image)",
        "EXT4_INODE_GROUP_IMAGE": "$(rlocationpath :inode_group_image)",
        "EXT4_LINEAR_DIRECTORY_IMAGE": "$(rlocationpath :linear_directory_image)",
        "EXT4_EXTENT_MUTATION_IMAGE": "$(rlocationpath :extent_mutation_image)",
        "EXT4_MULTI_GROUP_IMAGE": "$(rlocationpath :multi_group_image)",
    },
    rustc_flags = [
        "-Cpanic=abort",
        "-Zpanic_abort_tests",
        "-Crelocation-model=static",
    ],
    deps = [":ext4"],
)

# A sparse ext2 file with data beyond the single-indirect range exercises the
# legacy double-indirect map using an image generated independently by mke2fs.
genrule(
    name = "legacy_image",
    srcs = ["testdata/hello.txt"],
    outs = ["legacy.img"],
    cmd = """
set -eu
ROOT="$(@D)/legacy-image-root"
mkdir -p "$$ROOT"
cp $(location testdata/hello.txt) "$$ROOT/hello.txt"
truncate -s 400K "$$ROOT/large.bin"
dd if=$(location testdata/hello.txt) of="$$ROOT/large.bin" bs=1 seek=$$((300 * 1024)) conv=notrunc status=none
truncate -s 16M "$@"
/usr/sbin/mkfs.ext2 -q -F -b 1024 -d "$$ROOT" "$@"
/usr/sbin/e2fsck -fy "$@" >/dev/null
""",
)

rust_test(
    name = "legacy_image_test",
    srcs = ["tests/legacy_image.rs"],
    crate_name = "legacy_image_test",
    data = [":legacy_image"],
    edition = "2024",
    rustc_env = {
        "EXT4_LEGACY_IMAGE": "$(rlocationpath :legacy_image)",
    },
    rustc_flags = [
        "-Cpanic=abort",
        "-Zpanic_abort_tests",
        "-Crelocation-model=static",
    ],
    deps = [":ext4"],
)

compatibility_image(
    name = "orphan_file",
    features = "orphan_file",
)

# Upstream e2fsprogs 1.47.3+ defaults, shipped by current Arch Linux. Spell
# the complete ext4 profile out so this fixture stays modern even when CI's
# host mke2fs and /etc/mke2fs.conf are older.
compatibility_image(
    name = "modern_defaults",
    features = "sparse_super,large_file,filetype,resize_inode,dir_index,ext_attr,has_journal,extent,huge_file,flex_bg,metadata_csum,metadata_csum_seed,64bit,dir_nlink,extra_isize,orphan_file",
)

# 1 KiB blocks put only sixteen 64-byte descriptors in each descriptor
# block. Four hundred files force enumeration to load inodes beyond group 16,
# exercising the relocated second GDT block rather than merely its feature bit.
compatibility_image(
    name = "meta_bg",
    extra_args = "-b 1024 -g 1024 -N 1024",
    features = "meta_bg,^resize_inode,^flex_bg",
    files = 400,
)

compatibility_image(
    name = "legacy_gdt_csum",
    features = "uninit_bg,^metadata_csum,^orphan_file",
)

compatibility_image(
    name = "modern_incompat",
    features = "mmp,large_dir,ea_inode,encrypt,casefold,^orphan_file",
)

compatibility_image(
    name = "modern_layout",
    extra_args = "-C 16384",
    features = "bigalloc,metadata_csum_seed,sparse_super2,^resize_inode,^orphan_file",
)

compatibility_image(
    name = "inline_data",
    features = "inline_data,^orphan_file",
    repetitions = 6,
)

genrule(
    name = "inline_directory_image",
    outs = ["inline-directory.img"],
    cmd = """
set -eu
ROOT="$(@D)/inline-directory-root"
mkdir -p "$$ROOT/tiny"
i=0
while [ "$$i" -lt 6 ]; do
  printf x > "$$ROOT/tiny/child-$$i"
  i=$$((i + 1))
done
ln -s 012345678901234567890123456789012345678901234567890123456789012345678901234567890123 "$${ROOT}/long-link"
truncate -s 16M "$@"
/usr/sbin/mkfs.ext4 -q -F -O inline_data,^orphan_file -d "$$ROOT" "$@"
""",
)

genrule(
    name = "extended_attributes_image",
    srcs = ["testdata/hello.txt"],
    outs = ["extended-attributes.img"],
    cmd = """
set -eu
ROOT="$(@D)/extended-attributes-root"
mkdir -p "$$ROOT"
cp $(location testdata/hello.txt) "$$ROOT/attributed.txt"
cp $(location testdata/hello.txt) "$$ROOT/shared-a.txt"
cp $(location testdata/hello.txt) "$$ROOT/shared-b.txt"
truncate -s 16M "$@"
/usr/sbin/mkfs.ext4 -q -F -O ^orphan_file -d "$$ROOT" "$@"
printf small-value > "$(@D)/small-xattr"
dd if=/dev/zero bs=1000 count=1 status=none | tr '\\000' x > "$(@D)/large-xattr"
/usr/sbin/debugfs -w -R "ea_set -f $(@D)/small-xattr /attributed.txt user.small" "$@" >/dev/null
/usr/sbin/debugfs -w -R "ea_set -f $(@D)/large-xattr /attributed.txt security.large" "$@" >/dev/null
/usr/sbin/debugfs -w -R "ea_set -f $(@D)/large-xattr /shared-a.txt security.shared" "$@" >/dev/null
/usr/sbin/debugfs -w -R "ea_set -f $(@D)/large-xattr /shared-b.txt security.shared" "$@" >/dev/null
SHARED_BLOCK=$$(/usr/sbin/debugfs -R "stat /shared-a.txt" "$@" 2>/dev/null | awk '/File ACL:/ {print $$3}')
/usr/sbin/debugfs -w -R "set_inode_field /shared-b.txt file_acl $$SHARED_BLOCK" "$@" >/dev/null
/usr/sbin/e2fsck -fy "$@" >/dev/null || /usr/sbin/e2fsck -fy "$@" >/dev/null
""",
)

genrule(
    name = "ea_inode_image",
    srcs = ["testdata/hello.txt"],
    outs = ["ea-inode.img"],
    cmd = """
set -eu
ROOT="$(@D)/ea-inode-root"
mkdir -p "$$ROOT"
cp $(location testdata/hello.txt) "$$ROOT/attributed.txt"
truncate -s 16M "$@"
/usr/sbin/mkfs.ext4 -q -F -O ea_inode,^orphan_file -d "$$ROOT" "$@"
dd if=/dev/zero bs=6000 count=1 status=none | tr '\\000' z > "$(@D)/ea-inode-value"
/usr/sbin/debugfs -w -R "ea_set -f $(@D)/ea-inode-value /attributed.txt user.large" "$@" >/dev/null
/usr/sbin/e2fsck -fy "$@" >/dev/null || /usr/sbin/e2fsck -fy "$@" >/dev/null
""",
)

rust_test(
    name = "feature_compatibility_test",
    srcs = ["tests/feature_compatibility.rs"],
    crate_name = "feature_compatibility_test",
    data = [
        ":legacy_gdt_csum_image",
        ":inline_data_image",
        ":inline_directory_image",
        ":extended_attributes_image",
        ":ea_inode_image",
        ":meta_bg_image",
        ":modern_incompat_image",
        ":modern_layout_image",
        ":modern_defaults_image",
        ":orphan_file_image",
    ],
    edition = "2024",
    rustc_env = {
        "EXT4_LEGACY_GDT_CSUM_IMAGE": "$(rlocationpath :legacy_gdt_csum_image)",
        "EXT4_INLINE_DATA_IMAGE": "$(rlocationpath :inline_data_image)",
        "EXT4_INLINE_DIRECTORY_IMAGE": "$(rlocationpath :inline_directory_image)",
        "EXT4_EXTENDED_ATTRIBUTES_IMAGE": "$(rlocationpath :extended_attributes_image)",
        "EXT4_EA_INODE_IMAGE": "$(rlocationpath :ea_inode_image)",
        "EXT4_META_BG_IMAGE": "$(rlocationpath :meta_bg_image)",
        "EXT4_MODERN_INCOMPAT_IMAGE": "$(rlocationpath :modern_incompat_image)",
        "EXT4_MODERN_LAYOUT_IMAGE": "$(rlocationpath :modern_layout_image)",
        "EXT4_MODERN_DEFAULTS_IMAGE": "$(rlocationpath :modern_defaults_image)",
        "EXT4_ORPHAN_FILE_IMAGE": "$(rlocationpath :orphan_file_image)",
    },
    rustc_flags = [
        "-Cpanic=abort",
        "-Zpanic_abort_tests",
        "-Crelocation-model=static",
    ],
    deps = [":ext4"],
)
