load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//toolchain:musl_transition.bzl", "musl_binary")

package(default_visibility = ["//tests:__pkg__"])

rust_binary(
    name = "printmsg_bin",
    srcs = ["src/main.rs"],
    edition = "2024",
    rustc_flags = ["-Cstrip=symbols", "-Clinker-flavor=ld.lld", "-Clinker=rust-lld", "-Ctarget-feature=-sse,-sse2"],
)

musl_binary(
    name = "printmsg_elf",
    binary = ":printmsg_bin",
    visibility = ["//visibility:public"],
)
