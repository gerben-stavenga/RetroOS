# RetroOS boot config -- read by the kernel before the first DOS program
# runs. Each non-comment line is KEY=VALUE; lines override or extend the
# kernel's built-in master env (PATH only). Edit freely -- this file
# lives at C:\CONFIG\CONFIG.SYS on the writable data disk.
# Startup executable and optional arguments; restarted when it exits.
START=C:\RETROOS\DN\DN.COM

DNSWP=C:\TEMP
TEMP=C:\TEMP
DN=C:\CONFIG\DN
COMSPEC=C:\RETROOS\COMMAND.COM
PATH=C:\;C:\RETROOS;C:\TC;C:\BORLANDC\BIN
# Sound Blaster ownership. native = the guest drives the real card itself
# (no kernel mixing, no GM bank) — the only thing a 386/486, 86Box or Bochs
# can afford. mixed = emulate SB+OPL+GUS+GM and mix them out the card, which
# buys wavetable GUS/GM music on an SB-only machine if the CPU can spare it.
# Machines without a real SB (HDA/AC'97) always mix and ignore this.
SB_AUDIO=native
# HDA output preference: Speaker, Jack, or Headphone.
HDA_OUTPUT=Speaker
# Kernel-mixed master volume: 0 to 100 in steps of 10.
AUDIO_VOLUME=50

ADLIB=A388
BLASTER=A220 I7 D1 H5 P330 T6
ULTRASND=240,3,3,5,5
ULTRADIR=C:\ULTRASND
