# Build kernel using rules_rust and rules_nasm
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("@rules_nasm//nasm:defs.bzl", "nasm_library")
load("//toolchain:retro_platform.bzl", "retro_platform_files")

# Bare-metal (os:none) vs host build selector. The one kernel library and the
# metal ELF binary use this to pick platform-specific deps / linker flags.
config_setting(
    name = "metal",
    constraint_values = ["@platforms//os:none"],
)

nasm_library(
    name = "entry",
    srcs = ["src/arch/entry.asm"],
    copts = ["-f", "elf32"],
)

# The linker script, materialized into bazel-out so the rust_binary link action
# stages it reliably (a source file passed via compile_data wasn't found by the
# linker; bazel-out inputs are).
genrule(
    name = "kernel_ld",
    srcs = ["kernel.ld"],
    outs = ["kernel.generated.ld"],
    cmd = "cp $< $@",
)

# THE kernel: ONE backend-agnostic rust_library (rlib), linked by every entry
# binary below. The source gates its metal-only glue (boot.rs, fbcon, the
# `arch_metal` backend) with `#[cfg(target_arch = "x86")]`, so the same crate
# builds for the bare-metal target (arch-metal) and the host target
# (arch-interp, linked in by the hosted binaries). `select()` supplies the
# platform-specific dep flavours and the metal-only codegen flags.
rust_library(
    name = "kernel",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "kernel",
    edition = "2024",
    visibility = ["//visibility:public"],
    rustc_flags = [
        "-Cpanic=abort",
        # //lib + //arch-abi are -Crelocation-model=static (non-PIC); a PIE link
        # rejects them — build non-PIE to match, on both platforms.
        "-Crelocation-model=static",
    ] + select({
        ":metal": [
            "-Copt-level=s",
            "-Cforce-frame-pointers=yes",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "//arch-abi",
        "//klog",
        "//lib",
        "//lib:sound",
        "//third_party/lwext4:lwext4",
        "//third_party/lwext4:lwext4-sys",
        "//third_party/voodoo",
        # no_std-patched http_archive (not @crates): one flavour serves both
        # platforms — the synth core is pure integer math with zero deps.
        "@nuked_opl3//:nuked_opl3",
    ] + select({
        ":metal": [
            "//arch-metal",
            "@spin//:spin",
        ],
        "//conditions:default": [
            "@crates//:rustc-demangle",
            "@crates//:spin",
        ],
    }),
)

# ============================================================================
# Metal entry: the bootable kernel.elf, produced by rustc-linking the kernel
# rlib (+ arch-metal, pulled transitively) with the asm entry stub and the
# under the kernel linker script. Replaces the old
# `ld` genrule — the rlib is not self-contained, so rustc does the link.
# ============================================================================

# The asm `_start` stub is linked straight in as a native object via
# `-Clink-arg` (the bare-metal CC toolchain has only a dummy `ar`, so it can't
# go through `cc_library`). `_start` (kept by the script's ENTRY) calls the
# kernel's `boot_kernel`; rust-lld pulls `boot_kernel` and the rest out of the
# kernel rlib to satisfy the object's undefined references.
rust_binary(
    name = "kernel_elf_bin",
    srcs = ["metal_entry.rs"],
    crate_name = "kernel_metal",
    edition = "2024",
    compile_data = [":kernel_ld", ":entry", "//third_party/lwext4:lwext4_obj"],
    rustc_flags = [
        "-Cpanic=abort",
        "-Crelocation-model=static",
        # Link with rustc's bundled lld (the bare CC toolchain is dummy-only),
        # directly as ld.lld — the i686-unknown-none target's linker.
        "-Clink-self-contained=+linker",
        "-Clinker-flavor=ld.lld",
        "-Clinker=rust-lld",
        "-Clink-arg=-T$(location :kernel_ld)",
        "-Clink-arg=$(location :entry)",
        # lwext4 (writable ext4): the freestanding C object, linked straight in
        # like :entry. Its undefined externals (malloc/str*/qsort) resolve to the
        # arch-metal cshim; mem*/__udivdi3 to compiler-builtins.
        "-Clink-arg=$(location //third_party/lwext4:lwext4_obj)",
        "-Clink-arg=-nostdlib",
        "-Clink-arg=-no-pie",
    ],
    deps = [
        ":kernel",
        "//arch-metal",
    ],
)

# Keep the `//kernel:kernel_elf` label and the `kernel.elf` filename stable
# (run.sh reads bazel-bin/kernel/kernel.elf; //:image + the md5 genrule consume
# the label).
genrule(
    name = "kernel_elf",
    srcs = [":kernel_elf_bin"],
    outs = ["kernel.elf"],
    # STRIPPED. The symbol table is a quarter of the linked binary and is not
    # in any PT_LOAD, so no loader ever wanted it — it was pure weight on
    # everything that carries the kernel: the boot-bundle TAR the MBR stage
    # reads, the GRUB image, and the one file you copy onto a real machine.
    # Symbols ship separately as :kernel_sym -> C:\BOOT\KERNEL.SYM.
    cmd = "objcopy --strip-all $< $@",
    visibility = ["//visibility:public"],
)

# The symbol table on its own, for the in-kernel stack tracer. `--only-keep-debug`
# keeps .symtab/.strtab and turns the allocatable sections into NOBITS
# placeholders, so this is ~276 KB against the linked binary's 1 MB — and the
# tracer no longer slurps a second copy of .text it already has mapped.
genrule(
    name = "kernel_sym",
    srcs = [":kernel_elf_bin"],
    outs = ["kernel.sym"],
    cmd = "objcopy --only-keep-debug $< $@",
    visibility = ["//visibility:public"],
)

# ============================================================================
# Hosted entry binaries: link the SAME kernel rlib against arch-interp.
# ============================================================================

rust_binary(
    name = "retroos-host",
    srcs = ["src/main.rs"],
    crate_name = "retroos_host",
    edition = "2024",
    rustc_flags = [
        "-Cpanic=abort",
        "-Crelocation-model=static",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":kernel",
        "//arch-interp",
        "//lib",
        "//lib:sound",
        "//third_party/lwext4:lwext4",
        "//third_party/lwext4:lwext4-sys",
        "@lwext4//:lwext4_host",
    ],
)

rust_binary(
    name = "retroos-host-kvm",
    srcs = ["src/main.rs"],
    crate_name = "retroos_host",
    edition = "2024",
    rustc_flags = [
        "-Cpanic=abort",
        "-Crelocation-model=static",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":kernel",
        "//arch-interp:arch-interp-kvm",
        "//lib",
        "//lib:sound",
        "//third_party/lwext4:lwext4",
        "//third_party/lwext4:lwext4-sys",
        "@lwext4//:lwext4_host",
    ],
)
