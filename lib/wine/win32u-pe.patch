+#ifndef RETRO_SYNC_H
+#define RETRO_SYNC_H
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+typedef struct { RTL_RUN_ONCE once; RTL_CRITICAL_SECTION cs; } pthread_mutex_t;
+typedef int pthread_mutexattr_t;
+#define PTHREAD_MUTEX_INITIALIZER {0}
+#define PTHREAD_MUTEX_RECURSIVE 1
+static inline int pthread_mutexattr_init(int *a) { *a=0; return 0; }
+static inline int pthread_mutexattr_settype(int *a,int kind) { *a=kind; return 0; }
+static inline int pthread_mutexattr_destroy(int *a) { return 0; }
+static ULONG WINAPI retro_mutex_init(RTL_RUN_ONCE *once, void *arg, void **ctx) { RtlInitializeCriticalSection(arg); return TRUE; }
+static inline int pthread_mutex_init(pthread_mutex_t *m,const int *attr) { RtlRunOnceInitialize(&m->once); return 0; }
+static inline int pthread_mutex_lock(pthread_mutex_t *m) { RtlRunOnceExecuteOnce(&m->once,retro_mutex_init,&m->cs,0); return RtlEnterCriticalSection(&m->cs); }
+static inline int pthread_mutex_unlock(pthread_mutex_t *m) { return RtlLeaveCriticalSection(&m->cs); }
+static inline int pthread_mutex_destroy(pthread_mutex_t *m) { return RtlDeleteCriticalSection(&m->cs); }
+typedef RTL_RUN_ONCE pthread_once_t;
+#define PTHREAD_ONCE_INIT {0}
+static ULONG WINAPI retro_once(RTL_RUN_ONCE *once,void *arg,void **ctx) { ((void (*)(void))arg)(); return TRUE; }
+static inline int pthread_once(pthread_once_t *once,void (*fn)(void)) { return RtlRunOnceExecuteOnce(once,retro_once,fn,0); }
+typedef pthread_mutex_t pthread_rwlock_t;
+#define pthread_rwlock_init pthread_mutex_init
+#define pthread_rwlock_destroy pthread_mutex_destroy
+#define pthread_rwlock_rdlock pthread_mutex_lock
+#define pthread_rwlock_wrlock pthread_mutex_lock
+#define pthread_rwlock_unlock pthread_mutex_unlock
+#endif
