load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load(":modules.bzl", "WINE_DLLS", "WINE_FILES")
load("@rules_nasm//nasm:defs.bzl", "nasm_library")
load("//toolchain:windows_rust.bzl", "windows_rust_library")

package(default_visibility = ["//visibility:public"])

exports_files(["SOURCE.txt", "build_ntdll.py", "build_freetype.py", "font_mapping.c", "win32u-pe.patch", "server.c", "graphics.c"])

[genrule(
    name = name + "_dll",
    srcs = ["@wine_pe//:pe/" + name + ".dll"],
    outs = [name.upper() + ".DLL"],
    cmd = "cp $< $@",
) for name in WINE_DLLS]

pkg_tar(name = "runtime", files = WINE_FILES)

genrule(
    name = "backend_asm",
    srcs = ["//lib/wine/ntdll:backend-abi.json", "build_backend.py"],
    outs = ["backend.asm"],
    cmd = "python3 $(location build_backend.py) --abi $(location //lib/wine/ntdll:backend-abi.json) --asm $@",
)
nasm_library(name = "retroos_obj", srcs = [":backend_asm"], copts = ["-fwin32"])
windows_rust_library(name = "backend_rust", crate_root = "backend.rs")
genrule(
    name = "retroos_dll",
    srcs = [":server_obj", ":retroos_obj", ":backend_rust", "//lib/wine/ntdll:backend-abi.json", "build_backend.py"],
    tools = ["@open_watcom//:binl64/wlink"],
    outs = ["RETROOS.DLL"],
    cmd = "python3 $(location build_backend.py) --abi $(location //lib/wine/ntdll:backend-abi.json) " +
          "--server $(location :server_obj) --obj $(location :retroos_obj) --library $(location :backend_rust) " +
          "--linker $(location @open_watcom//:binl64/wlink) --output $@",
)

genrule(
    name = "server_obj",
    srcs = ["server.c", "callbacks.c", "threads.c", "@wine_source//:headers", "@wine_source//:include/windef.h"],
    outs = ["server.obj"],
    cmd = "wine_include=$$(dirname $(location @wine_source//:include/windef.h)); " +
          "clang-19 -target i686-windows -O2 -ffreestanding -fno-stack-protector " +
          "-D__WINESRC__ -D__WINE_PE_BUILD -D_UCRT -I$$wine_include -I$$wine_include/msvcrt " +
          "-c $(location server.c) -o $@",
)

genrule(
    name = "freetype_license",
    srcs = ["@wine_freetype_tar//file"],
    outs = ["FREETYPE-LICENSE.TXT"],
    cmd = "tar -xOf $(location @wine_freetype_tar//file) freetype-2.13.3/docs/FTL.TXT > $@",
)
