load(":filesystem_layout.bzl", "BOOT_FILES", "DATA_FILES", "LINUX_FILES", "BOOT_SIZE_MB", "DOS_SIZE_MB", "LINUX_SIZE_MB")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_pkg//pkg:mappings.bzl", "pkg_mklink")

exports_files(["i686-retro-none.json", "hostfs.py"])

# ── Content packaged out of apps/ ────────────────────────────────────────────
#
# apps/ holds shipped CONTENT only and carries no BUILD files of its own, so
# every file under it belongs to this package and is globbed from here. Things
# built from source live in test/, tools/, shell/ instead.

# The standard Gravis UltraSound instrument patches (.PAT), as originally
# distributed with the GUS drivers and long redistributed as dgguspat.zip
# (idgames /music/dgguspat, packaged by Simon Howard — see dgguspat.txt).
# Ships at C:\ULTRASND\MIDI, the ULTRADIR default every GUS-native game and
# driver (Doom's DMX, AIL, ULTRAMID) loads instrument data from — without
# these, games detect the emulated GUS but silently disable music.
_ULTRASND_PREFIX = "apps/ultrasnd/"

_PATS = glob([_ULTRASND_PREFIX + "MIDI/*.pat"])

pkg_tar(
    name = "ultrasnd_tar",
    files = {
        ":" + p: "ULTRASND/" + p[len(_ULTRASND_PREFIX):].upper()
        for p in _PATS
    } | {
        ":" + _ULTRASND_PREFIX + "dgguspat.txt": "ULTRASND/DGGUSPAT.TXT",
    },
    visibility = ["//visibility:public"],
)

# All files under apps/games are auto-included with their paths uppercased and
# prefixed with "GAMES/" (e.g. doom/DOOM.EXE → GAMES/DOOM/DOOM.EXE). Drop a
# game's files into a subdirectory and they ship on next build — no per-file
# wiring.
_GAMES_PREFIX = "apps/games/"

_GAME_SRCS = glob(
    [_GAMES_PREFIX + "**/*"],
    # A direct/hosted game run can write state into this source directory.
    exclude = ["apps/games/skyroads/SKYROADS.CFG"],
)

pkg_tar(
    name = "games_tar",
    files = {
        ":" + s: "GAMES/" + s[len(_GAMES_PREFIX):].upper()
        for s in _GAME_SRCS
    },
    visibility = ["//visibility:public"],
)

# Static-linked busybox 1.31 (i686-uclibc) — single-binary userland for the
# Linux personality. Provides sh + coreutils via the standalone-shell-mode
# applet dispatch (basename(argv[0]) -> applet).
exports_files(["apps/busybox/busybox"])

# One real GUS instrument, compiled into //lib:sound_test so the .PAT parser
# is checked against a shipped file and not only synthetic fixtures.
exports_files(["apps/ultrasnd/MIDI/acpiano.pat"])


# Convenient applet shims for busybox: each is a tar symlink "bin/<name>"
# pointing at "busybox" (relative within /bin), so PATH=/bin lookup of
# `ls`, `cat`, etc. resolves to the busybox binary which dispatches via
# basename(argv[0]).
_BUSYBOX_APPLETS = [
    "ls", "cat", "cp", "mv", "rm", "mkdir", "rmdir", "ln", "touch",
    "echo", "printf", "pwd", "true", "false",
    "grep", "sed", "awk", "wc", "sort", "uniq", "head", "tail", "cut", "tr",
    "find", "du", "df", "stat", "chmod",
    "ps", "kill", "sleep", "time", "id", "tty", "uname",
    "cmp", "diff", "tar", "gzip", "gunzip", "dd",
    "vi", "ed", "more", "less",
    "sh", "ash", "env", "which", "test", "[",
]

[pkg_mklink(
    name = "lnk_bin_" + a,
    link_name = "bin/" + a,
    target = "busybox",
) for a in _BUSYBOX_APPLETS]

# Pristine drop-in dirs: contents auto-shipped under the given DOS prefix.
# Drop files into apps-boot/tc/ or apps/TP70/ and they appear at C:\TC\... or
# C:\TP70\... in the image on the next build — no per-file wiring.
_TC_SRCS = glob(["apps-boot/tc/**/*"], allow_empty = True)
_TP70_SRCS = glob(["apps/TP70/**/*"], allow_empty = True)

pkg_tar(
    name = "tc_tar",
    files = {":" + s: "TC/" + s[len("apps-boot/tc/"):].upper() for s in _TC_SRCS},
)

pkg_tar(
    name = "tp70_tar",
    files = {":" + s: "TP70/" + s[len("apps/TP70/"):].upper() for s in _TP70_SRCS},
)

# Compute MD5 of kernel ELF
genrule(
    name = "kernel_md5",
    srcs = ["//kernel:kernel_elf"],
    outs = ["kernel.elf.md5"],
    cmd = "md5sum $< | cut -d' ' -f1 | xxd -r -p > $@",
)

# Runtime files are separate from the persistent DN defaults in DATA_FILES.
_BOOT_DIR_FILES = dict(BOOT_FILES)

# Boot bundle (small TAR, partition 1): the LEGACY BOOTLOADER's kernel
# source only — the MBR stage reads kernel.elf (+ md5) from it. The kernel
# itself never mounts it. Everything else, C:\RETROOS included, lives on ext4.
_BOOT_FILES = {
    "//boot:bootloader_bin": "A",
    ":kernel_md5": "kernel.elf.md5",
    "//kernel:kernel_elf": "kernel.elf",
}

# image_min's boot bundle is the same kernel. There used to be a second
# "bare" kernel here: the full one embedded COMMAND.COM, which is built by
# booting image_min, so image_min needed a kernel without it. Now that
# C:\RETROOS is ordinary ext4 content the kernel embeds nothing and the cycle
# is gone with it.
_BOOT_FILES_MIN = dict(_BOOT_FILES)

# Extras (live on ext4 in the boot+ext4 image, or alongside boot files in the
# monolithic open-source image). Linux-personality binaries, test programs,
# and busybox.
_EXTRA_FILES = dict(DATA_FILES)
_EXTRA_FILES.update(LINUX_FILES)
_EXTRA_FILES.update(_BOOT_DIR_FILES)

# Minimum extras needed for the stub-build image (//tools/dosrt:stub_exe
# boots //:image_min and runs in-OS TCC from ext4 /TC;
# CONFIG.SYS supplies the PATH
# (= C:\;C:\RETROOS\TC;C:\BORLANDC\BIN) so TCC can find TLINK.EXE. Keeping
# this tiny avoids the image→modplay→stub_exe→image cycle that would
# otherwise force a separate `dosrt_tar` indirection.
_MIN_EXTRA_FILES = {
    "etc/CONFIG.SYS": "CONFIG.SYS",
    # In-OS tinkering source for COMMAND.COM (used to ride the boot TAR).
    "//tools/command:command.c": "SRC/COMMAND.C",
}

# Monolithic file map for the open-source image and FreeDOS apps disk —
# both consume a single flat tar. The proprietary image splits these
# back into boot_bundle_tar + extras_tar_proprietary.
_BASE_FILES = dict(_BOOT_FILES)
_BASE_FILES.update(_EXTRA_FILES)

# Boot bundle: just enough to bring up DN + the in-OS TC self-build.
# Becomes partition 1 (type 0xDA); mounts at /boot/. Same bundle for both
# the open-source and proprietary images.
pkg_tar(
    name = "boot_bundle_tar",
    files = _BOOT_FILES,
)

pkg_tar(
    name = "boot_bundle_min_tar",
    files = _BOOT_FILES_MIN,
)

# Just enough on ext4 for the stub-build image: CONFIG.SYS (for TCC's
# PATH) and the TC toolchain itself (the boot TAR is bootloader-only now).
# Used only by image_min; keeps the build acyclic.
pkg_tar(
    name = "extras_min_tar",
    files = _MIN_EXTRA_FILES,
    deps = [":tc_tar"],
)

# FS-layout convention (see BootConfig.c_root): the Linux root holds only the
# busybox userland at /bin; everything DOS lives under C: = /home/retroos. The
# shared _EXTRA_FILES / dep tars stay root-relative (the FreeDOS flat disk wants
# that); the home/retroos/ prefix is applied here via package_dir.
# busybox + applet shims at /bin (the Linux side, NOT under home/retroos).
pkg_tar(
    name = "bin_tar",
    files = LINUX_FILES,
    srcs = [":lnk_bin_" + a for a in _BUSYBOX_APPLETS],
)

# DOS content (everything in _EXTRA_FILES except busybox) + games/TC/TP70,
# all under C: = /home/retroos.
_DOS_EXTRA = {k: v for k, v in _EXTRA_FILES.items() if v != "bin/busybox"}
pkg_tar(
    name = "dos_extras_tar",
    empty_dirs = ["TEMP"],
    files = _DOS_EXTRA,
    deps = [
        ":games_tar",
        ":ultrasnd_tar",
        ":tc_tar",
        ":tp70_tar",
    ],
    package_dir = "home/retroos",
)

# Raw ext4 images consumed directly by GRUB's Multiboot module command. The
# image root is the declared mount point; no partition table or boot label is
# part of this transport.
pkg_tar(
    name = "root_module_dos_tar",
    empty_dirs = ["TEMP"],
    files = _DOS_EXTRA,
    deps = [":ultrasnd_tar", ":tc_tar", ":tp70_tar"],
    package_dir = "home/retroos",
)

pkg_tar(
    name = "root_module_base_tar",
    deps = [":bin_tar", ":root_module_dos_tar"],
)

pkg_tar(
    name = "games_module_tar",
    files = {":" + s: s[len(_GAMES_PREFIX):].upper() for s in _GAME_SRCS},
)

# Extras populated into the ext4 partition: the /bin busybox userland plus the
# /home/retroos DOS world.
pkg_tar(
    name = "extras_tar",
    deps = [":bin_tar", ":dos_extras_tar"],
)

# Same, plus the proprietary game/tooling drop. CONFIG.SYS is dropped from the
# DOS file map so apps-proprietary's own CONFIG.SYS is the only one.
_DOS_EXTRA_PROPRIETARY = {k: v for k, v in _DOS_EXTRA.items() if k != "etc/CONFIG.SYS"}
pkg_tar(
    name = "dos_extras_tar_proprietary",
    empty_dirs = ["TEMP"],
    files = _DOS_EXTRA_PROPRIETARY,
    deps = [
        ":games_tar",
        ":ultrasnd_tar",
        ":tc_tar",
        ":tp70_tar",
        "//apps-proprietary:tar",
    ],
    package_dir = "home/retroos",
)
pkg_tar(
    name = "extras_tar_proprietary",
    deps = [":bin_tar", ":dos_extras_tar_proprietary"],
)

# Flat tar used by the FreeDOS data disk (mformat / mcopy). Keeps the
# boot bundle and extras together since FAT16 is one volume.
pkg_tar(
    name = "fs_tar_proprietary",
    files = _BASE_FILES,
    srcs = [":lnk_bin_" + a for a in _BUSYBOX_APPLETS],
    deps = [
        ":games_tar",
        ":ultrasnd_tar",
        ":tc_tar",
        ":tp70_tar",
        "//apps-proprietary:tar",
    ],
)

# Disk image layout (used by both image and image_proprietary):
#   sector 0           bootloader/MBR (with patched partition table)
#   sector 1..         boot bundle TAR (kernel.elf for the MBR loader only)
#   sector EXT4_START  ext4 partition: extras + BOOT + TC + games (+ proprietary)
# The kernel scans the MBR for the ext4 root; C:\RETROOS is a directory on it.
#
# EXT4_START leaves 32 MiB of headroom for the boot bundle. Anything bigger
# should live on ext4.
_DISK_CMD = """
    set -euo pipefail

    EXT4_START=65536               # 32 MiB / 512
    # The proprietary payload leaves little useful free space in a 1.25 GiB
    # filesystem.  Keep enough room for installing games from the CD images
    # carried by that same payload.
    EXT4_SECTORS=$$((2048 * 2048)) # 2 GiB / 512

    # Strip the leading TAR header for "A" so byte 0 of the partition
    # is the bootloader (which embeds the MBR + partition table at the
    # tail of its first 512 bytes).
    BOOT_RAW=$$(mktemp)
    tail -c +513 $(BOOT_TAR) > "$$BOOT_RAW"

    BOOT_SIZE=$$(stat -c%s "$$BOOT_RAW")
    BOOT_BUDGET=$$(( EXT4_START * 512 ))
    if [ "$$BOOT_SIZE" -gt "$$BOOT_BUDGET" ]; then
        echo "boot_bundle_tar (after MBR strip) is $$BOOT_SIZE B, exceeds boot partition budget $$BOOT_BUDGET B" >&2
        exit 1
    fi

    cp "$$BOOT_RAW" $@
    chmod +w $@
    truncate -s $$(( (EXT4_START + EXT4_SECTORS) * 512 )) $@
    rm -f "$$BOOT_RAW"

    EXT4_IMG=$$(mktemp)
    EXTRACT_DIR=$$(mktemp -d)
    tar xf $(EXTRAS_TAR) -C "$$EXTRACT_DIR"

    # RetroOS writes a file only when it belongs to RetroOS's group (the gid of
    # its own C: root) AND carries the group-write bit -- ordinary Unix
    # permissions, checked against the ext4 inode. The
    # tar arrives 0555/0755, so without this the image would be honestly
    # read-only and every savegame would fail with "access denied". Extraction
    # as the build user already gives the whole tree one consistent gid, which
    # IS the retroos group by definition.
    # (image_min carries no home/retroos -- only CONFIG.SYS -- so guard it.)
    if [ -d "$$EXTRACT_DIR/home/retroos" ]; then
        chmod -R g+w "$$EXTRACT_DIR/home/retroos"
    fi
    truncate -s $$(( EXT4_SECTORS * 512 )) "$$EXT4_IMG"
    mkfs.ext4 -q -b 4096 -L "RetroOS" -d "$$EXTRACT_DIR" "$$EXT4_IMG"
    rm -rf "$$EXTRACT_DIR"
    dd if="$$EXT4_IMG" of=$@ bs=512 seek=$$EXT4_START conv=notrunc 2>/dev/null
    rm "$$EXT4_IMG"

    # Patch MBR partition table: entry 1 (boot TAR) needs a real size so
    # strict BIOSes (86box) accept the disk; entry 2 announces ext4 for
    # the kernel's MBR scan.
    python3 -c "
import struct
with open('$@', 'r+b') as f:
    f.seek(0x1BE)
    p1 = f.read(16)
    p1_lba = struct.unpack_from('<I', p1, 8)[0]
    p1_size = $$EXT4_START - p1_lba
    f.seek(0x1BE + 12)
    f.write(struct.pack('<I', p1_size))
    f.seek(0x1CE)
    f.write(struct.pack('<BBBBBBBBII',
        0x00, 0,0,0, 0x83, 0,0,0,
        $$EXT4_START, $$EXT4_SECTORS))
    "
"""

# Stub-build image: the boot bundle + just CONFIG.SYS and TC. Pulls NO dosrt
# artifacts, so image→modplay→stub_exe→image_min is not a cycle.
genrule(
    name = "image_min",
    srcs = [":boot_bundle_min_tar", ":extras_min_tar"],
    outs = ["image_min.bin"],
    cmd = _DISK_CMD
        .replace("$(BOOT_TAR)", "$(location :boot_bundle_min_tar)")
        .replace("$(EXTRAS_TAR)", "$(location :extras_min_tar)"),
    # Consumed by //tools/dosrt:stub_exe and //tools/command:command_com
    # (the in-OS TC compile host).
    visibility = ["//visibility:public"],
)

genrule(
    name = "image",
    srcs = [":boot_bundle_tar", ":extras_tar"],
    outs = ["image.bin"],
    cmd = _DISK_CMD
        .replace("$(BOOT_TAR)", "$(location :boot_bundle_tar)")
        .replace("$(EXTRAS_TAR)", "$(location :extras_tar)"),
    visibility = ["//visibility:public"],
)

genrule(
    name = "image_proprietary",
    srcs = [":boot_bundle_tar", ":extras_tar_proprietary"],
    outs = ["image_proprietary.bin"],
    cmd = _DISK_CMD
        .replace("$(BOOT_TAR)", "$(location :boot_bundle_tar)")
        .replace("$(EXTRAS_TAR)", "$(location :extras_tar_proprietary)"),
)

# FAT16 data disk for FreeDOS (all apps from the proprietary TAR)
genrule(
    name = "freedos_apps",
    srcs = [
        ":fs_tar_proprietary",
        "//freedos/cwsdpmi:cwsdpmi_exe",
        "freedos/ctmouse/CTMOUSE.EXE",
        "freedos/hx/HDPMI16.EXE",
        "freedos/hx/HDPMI16D.EXE",
        "freedos/hx/HDPMI32.EXE",
        "freedos/hx/HDPMI32I.EXE",
        "freedos/hx/SETUPBC.BAT",
    ],
    outs = ["freedos_apps.img"],
    cmd = """
        IMG="$$(pwd)/$@"
        # 1GB FAT16 superfloppy: BORLANDC + games push past 256MB.
        dd if=/dev/zero of="$$IMG" bs=1M count=1024 status=none
        mformat -i "$$IMG" -c 32 -h 16 -s 63 -T $$((1024 * 2048)) ::

        # Extract TAR and copy files to FAT image
        TMPDIR=$$(mktemp -d)
        tar xf "$$(pwd)/$(location :fs_tar_proprietary)" -C "$$TMPDIR"
        # Skip non-DOS files (kernel, ELF binaries, md5, bootloader)
        cd "$$TMPDIR"
        for f in $$(find . -type f | sort); do
            # Skip kernel/bootloader/ELF/linux files
            case "$$f" in
                ./A|./kernel.elf|./kernel.elf.md5|./shell.elf) continue ;;
                ./TESTS/printmsg.elf|./TESTS/stress.elf|./TESTS/stress64.elf) continue ;;
                ./TESTS/HI.ELF|./TESTS/HI64.ELF) continue ;;
            esac
            DIR=$$(dirname "$$f" | sed 's|^\\./||')
            if [ "$$DIR" != "." ]; then
                # Create all parent dirs
                P=""
                IFS=/; for COMP in $$DIR; do
                    P="$${P:+$$P/}$$COMP"
                    mmd -D s -i "$$IMG" "::$$P" 2>/dev/null || true
                done
                unset IFS
            fi
            mcopy -D o -i "$$IMG" "$$f" "::$$f" 2>/dev/null || true
        done
        cd - >/dev/null
        rm -rf "$$TMPDIR"

        # Drop CWSDPMI.EXE at D:\\ root so it's on the PATH for any DOS/4GW
        # game (DOS/4GW probes a loaded DPMI host before falling back to its
        # own embedded mode-switching). Run `CWSDPMI -p` in AUTOEXEC.BAT or
        # the prompt to load it resident before launching the game.
        # This is OUR from-source build (//freedos/cwsdpmi), not the stock
        # binary — so the disk always ships whatever cwsdpmi/ currently is.
        mcopy -D o -i "$$IMG" "$$(pwd)/$(location //freedos/cwsdpmi:cwsdpmi_exe)" "::CWSDPMI.EXE"

        # FreeDOS CTMOUSE driver at D:\\CTMOUSE.EXE. Run `CTMOUSE` before
        # launching mouse-aware games (e.g. Indy: Fate of Atlantis) to
        # install an INT 33h handler.
        mcopy -D o -i "$$IMG" "$$(pwd)/freedos/ctmouse/CTMOUSE.EXE" "::CTMOUSE.EXE"

        # Japheth HX HDPMI16/HDPMI32 — open-source 16/32-bit DPMI hosts at
        # D:\\HDPMI16.EXE / D:\\HDPMI32.EXE. HDPMI16D.EXE is a local
        # debug build with port E9 trace output. Load `HDPMI16` (TSR) before
        # BCC.EXE so BCC's runtime sees an existing DPMI host via INT 2F
        # AX=1687h instead of installing its own DPMI16BI.OVL — useful
        # for diagnosing whether a BCC behavior is host-side (DPMI16BI
        # quirk) or BCC-side (would reproduce under HDPMI16 too).
        mcopy -D o -i "$$IMG" "$$(pwd)/freedos/hx/HDPMI16.EXE" "::HDPMI16.EXE"
        mcopy -D o -i "$$IMG" "$$(pwd)/freedos/hx/HDPMI16D.EXE" "::HDPMI16D.EXE"
        mcopy -D o -i "$$IMG" "$$(pwd)/freedos/hx/HDPMI32.EXE" "::HDPMI32.EXE"
        mcopy -D o -i "$$IMG" "$$(pwd)/freedos/hx/HDPMI32I.EXE" "::HDPMI32I.EXE"
        # SETUPBC.BAT — sets PATH/INCLUDE/LIB for BCC on D: (FreeDOS).
        # Run `D:\\SETUPBC` once after booting to make BCC find its headers.
        mcopy -D o -i "$$IMG" "$$(pwd)/freedos/hx/SETUPBC.BAT" "::SETUPBC.BAT"
    """,
)

# Diskless Multiboot module images are plain raw ext4 volumes.
genrule(
    name = "root_module_base_image",
    srcs = [":root_module_base_tar", "tools/build_module_image.py"],
    outs = ["retroos-base.img"],
    cmd = "python3 $(location tools/build_module_image.py)" +
          " --contents $(location :root_module_base_tar) --size-mb 32 --out $@",
    visibility = ["//visibility:public"],
)

genrule(
    name = "root_module_base_gzip",
    srcs = [":root_module_base_image"],
    outs = ["retroos-base.img.gz"],
    cmd = "gzip -9 -n -c $(location :root_module_base_image) > $@",
    visibility = ["//visibility:public"],
)

genrule(
    name = "root_module_games_image",
    srcs = [":games_module_tar", "tools/build_module_image.py"],
    outs = ["retroos-games.img"],
    cmd = "python3 $(location tools/build_module_image.py)" +
          " --contents $(location :games_module_tar) --size-mb 96 --writable-root --out $@",
    visibility = ["//visibility:public"],
)

genrule(
    name = "root_module_games_gzip",
    srcs = [":root_module_games_image"],
    outs = ["retroos-games.img.gz"],
    cmd = "gzip -9 -n -c $(location :root_module_games_image) > $@",
    visibility = ["//visibility:public"],
)

genrule(
    name = "grub_module_iso",
    srcs = ["//kernel:kernel_elf", ":root_module_base_gzip", ":root_module_games_gzip", "tools/grub-module.cfg"],
    outs = ["retroos_grub_module.iso"],
    cmd = """
        DIR=$$(mktemp -d)
        mkdir -p "$$DIR/boot/grub"
        cp $(location //kernel:kernel_elf) "$$DIR/boot/kernel.elf"
        cp $(location :root_module_base_gzip) "$$DIR/boot/retroos-base.img.gz"
        cp $(location :root_module_games_gzip) "$$DIR/boot/retroos-games.img.gz"
        cp $(location tools/grub-module.cfg) "$$DIR/boot/grub/grub.cfg"
        grub-mkrescue -o $@ "$$DIR"
        rm -rf "$$DIR"
    """,
    visibility = ["//visibility:public"],
)

# GRUB-booted hard-disk image: ONE ext4 partition, GRUB in the MBR gap, the
# kernel at /boot/kernel.elf. No RetroOS bootloader and no boot-bundle
# partition — installing on real hardware is `grub-install` plus a menuentry
# instead of dd'ing our MBR. The legacy `image` target still builds the
# own-bootloader layout; this is the candidate replacement.
#
# Needs grub-mkimage + the i386-pc modules (grub-pc-bin) and mkfs.ext4.
genrule(
    name = "image_grub",
    srcs = [
        "//kernel:kernel_elf",
        ":extras_tar",
        "tools/grub-hdd.cfg",
        "tools/build_grub_hdd.py",
    ],
    outs = ["image_grub.bin"],
    cmd = "python3 $(location tools/build_grub_hdd.py)" +
          " --kernel $(location //kernel:kernel_elf)" +
          " --extras $(location :extras_tar)" +
          " --grub-cfg $(location tools/grub-hdd.cfg)" +
          " --out $@",
    visibility = ["//visibility:public"],
)

# GRUB bootable ISO (requires grub-mkrescue and mtools)
# Boot: qemu -cdrom retroos_grub.iso -drive file=image_ext4.bin,snapshot=on -boot order=d
genrule(
    name = "grub_iso",
    srcs = ["//kernel:kernel_elf"],
    outs = ["retroos_grub.iso"],
    cmd = """
        DIR=$$(mktemp -d)
        mkdir -p "$$DIR/boot/grub"
        cp $< "$$DIR/boot/kernel.elf"
        cat > "$$DIR/boot/grub/grub.cfg" << 'GRUBCFG'
set timeout=1
insmod all_video
insmod vbe
insmod vga
set gfxmode=1024x768x32
set gfxpayload=1024x768x32
menuentry "RetroOS" {
    multiboot /boot/kernel.elf
    boot
}
GRUBCFG
        grub-mkrescue -o $@ "$$DIR"
        rm -rf "$$DIR"
    """,
)

# Run QEMU with the disk image
sh_binary(
    name = "run",
    srcs = ["run_qemu.sh"],
    data = [":image"],
)

# ===========================================================================
# Two-disk layout: a disposable boot disk + a persistent data disk.
# ===========================================================================
# The single image conflated two things with opposite lifetimes: the product
# being built (kernel, bootloader, DOS userland) and the user's world (games,
# savegames, installed CDs). Splitting them along the file boundary means a
# rebuild never has to rewrite guest state.
#
#   :boot_disk   GRUB + kernel.elf + C:\RETROOS. Rebuilt every launch.
#   :data_disk   FAT32 C: (FreeDOS-bootable) + ext4 Linux root. Seeded once.
#
# See tools/build_boot_disk.py and tools/build_data_disk.py for the layouts and
# why C: must be FAT and must be C: on both sides.

# C:\RETROOS, on the BOOT disk rather than on C: itself: it is versioned with the
# kernel, so it belongs with the kernel. Paths already carry the RETROOS/ prefix.
pkg_tar(
    name = "boot_dir_tar",
    files = _BOOT_DIR_FILES,
)

# One build target keeps the installed kernel and all runtime files matched.
pkg_tar(
    name = "machine_boot_tar",
    files = BOOT_FILES | {"//kernel:kernel_elf": "kernel.elf"},
)

# The data manifest declares lifetime explicitly, including any writable
# configuration under RETROOS/. Do not infer ownership from path prefixes.
_C_DRIVE_FILES = dict(DATA_FILES)

# Flat at the volume root -- a FAT volume IS C:, so there is no home/retroos
# prefix to apply here (contrast dos_extras_tar, which prefixes for ext4).
pkg_tar(
    name = "c_drive_tar",
    empty_dirs = ["TEMP"],
    files = _C_DRIVE_FILES,
    deps = [
        ":games_tar",
        ":ultrasnd_tar",
        ":tc_tar",
        ":tp70_tar",
    ],
)

# Same, plus the proprietary drop. Its own CONFIG.SYS wins, so ours is dropped
# rather than shadowed (see dos_extras_tar_proprietary).
_C_DRIVE_FILES_PROPRIETARY = {
    k: v
    for k, v in _C_DRIVE_FILES.items()
    if k != "etc/CONFIG.SYS"
}

pkg_tar(
    name = "c_drive_tar_proprietary",
    empty_dirs = ["TEMP"],
    files = _C_DRIVE_FILES_PROPRIETARY,
    deps = [
        ":games_tar",
        ":ultrasnd_tar",
        ":tc_tar",
        ":tp70_tar",
        "//apps-proprietary:tar",
    ],
)

_BOOT_DISK_CMD = """
    set -euo pipefail
    BOOT_DIR=$$(mktemp -d)
    tar xf $(location :boot_dir_tar) -C "$$BOOT_DIR"
    python3 $(location tools/build_boot_disk.py) \
        --kernel $(location //kernel:kernel_elf) \
        --boot-tree "$$BOOT_DIR" \
        --size-mb {BOOT_SIZE_MB} \
        --out $@
    rm -rf "$$BOOT_DIR"
"""

genrule(
    name = "boot_disk",
    srcs = [
        "//kernel:kernel_elf",
        ":boot_dir_tar",
        "tools/build_boot_disk.py",
    ],
    outs = ["boot_disk.bin"],
    cmd = _BOOT_DISK_CMD.replace("{BOOT_SIZE_MB}", str(BOOT_SIZE_MB)),
    # grub-mkimage/grub-mkstandalone and /usr/lib/grub come from the host, as
    # they already do for :grub_iso.
    local = True,
    visibility = ["//visibility:public"],
)

# $(C_TAR) is the C: content; everything else is identical between the
# shareware and proprietary data disks.
_DATA_DISK_CMD = """
    set -euo pipefail
    C_DIR=$$(mktemp -d)
    LINUX_DIR=$$(mktemp -d)
    tar xf $(C_TAR) -C "$$C_DIR"
    tar xf $(location :bin_tar) -C "$$LINUX_DIR"
    python3 $(location tools/build_data_disk.py) \
        --dos-tree "$$C_DIR" \
        --linux-tree "$$LINUX_DIR" \
        --freedos-src freedos/sys \
        --fat-mb {DOS_SIZE_MB} --ext4-mb {LINUX_SIZE_MB} \
        --out $@
    rm -rf "$$C_DIR" "$$LINUX_DIR"
"""

_DATA_DISK_CMD = _DATA_DISK_CMD.replace("{DOS_SIZE_MB}", str(DOS_SIZE_MB)).replace("{LINUX_SIZE_MB}", str(LINUX_SIZE_MB))

_FREEDOS_SRCS = [
    "freedos/sys/bootnorm.asm",
    "freedos/sys/boot32lb.asm",
    "freedos/sys/KERNEL.SYS",
    "freedos/sys/COMMAND.COM",
]

genrule(
    name = "data_disk",
    srcs = [
        ":c_drive_tar",
        ":bin_tar",
        "tools/build_data_disk.py",
    ] + _FREEDOS_SRCS,
    outs = ["data_disk.bin"],
    cmd = _DATA_DISK_CMD.replace("$(C_TAR)", "$(location :c_drive_tar)"),
    local = True,
    visibility = ["//visibility:public"],
)

genrule(
    name = "data_disk_proprietary",
    srcs = [
        ":c_drive_tar_proprietary",
        ":bin_tar",
        "tools/build_data_disk.py",
    ] + _FREEDOS_SRCS,
    outs = ["data_disk_proprietary.bin"],
    cmd = _DATA_DISK_CMD.replace("$(C_TAR)",
                                 "$(location :c_drive_tar_proprietary)"),
    local = True,
    visibility = ["//visibility:public"],
)

# Public release artifacts. Both bundles build from explicit public targets;
# apps-proprietary and existing writable images are never release inputs.
pkg_tar(
    name = "release_vm",
    mode = "0644",
    files = {
        ":boot_disk": "boot.img",
        ":data_disk": "data.img",
        "tools/release/run.sh": "run.sh",
        "tools/run/qemu.sh": "tools/run/qemu.sh",
        "tools/release/README.md": "README.md",
    },
    modes = {"run.sh": "0755"},
    extension = "tar.gz",
    out = "retroos-vm.tar.gz",
)

pkg_tar(
    name = "release_machine",
    mode = "0644",
    files = {
        ":machine_boot_tar": "machine_boot.tar",
        "tools/release/install.sh": "install.sh",
        "tools/machine_install.py": "tools/machine_install.py",
        "tools/migrate_dn_state.py": "tools/migrate_dn_state.py",
        "//tools/command:LOADFIX.CFG": "tools/command/LOADFIX.CFG",
        "etc/CONFIG.SYS": "etc/CONFIG.SYS",
        "tools/release/README.md": "README.md",
    } | {src: src for src, dest in DATA_FILES.items() if dest.startswith("CONFIG/DN/")},
    modes = {"install.sh": "0755"},
    extension = "tar.gz",
    out = "retroos-machine.tar.gz",
)

genrule(
    name = "release_checksums",
    srcs = [":release_vm", ":release_machine"],
    outs = ["SHA256SUMS"],
    cmd = "sha256sum $(locations :release_vm) $(locations :release_machine) | sed 's|  .*/|  |' > $@",
)

filegroup(
    name = "release",
    srcs = [":release_vm", ":release_machine", ":release_checksums"],
    visibility = ["//visibility:public"],
)
