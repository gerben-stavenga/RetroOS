+
+/// Cursor and directory-entry state without a borrow of the mounted filesystem.
+pub struct FileState {
+    first_cluster: Option<u32>,
+    current_cluster: Option<u32>,
+    offset: u32,
+    entry: Option<DirEntryEditor>,
+}
+
+impl FileState {
+    /// Resume the cursor on its originating filesystem.
+    pub fn resume<IO: ReadWriteSeek, TP, OCC>(self, fs: &FileSystem<IO, TP, OCC>) -> File<'_, IO, TP, OCC> {
+        File {
+            first_cluster: self.first_cluster,
+            current_cluster: self.current_cluster,
+            offset: self.offset,
+            entry: self.entry,
+            fs,
+            suspended: false,
+        }
+    }
 }
 
