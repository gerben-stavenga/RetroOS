RetroOS: end scalar port I/O translation blocks at the next instruction.

uc_emu_stop from an I/O hook only takes effect when the TB exits. Continuing
inside that TB can consume the dummy IN result, change OUT registers, or raise
a later fault that hides the I/O event (Doom loses its IRQ0 EOI this way).

--- a/qemu/target/i386/translate.c
+++ b/qemu/target/i386/translate.c
@@ -7039,9 +7039,9 @@
         gen_helper_in_func(tcg_ctx, ot, s->T1, s->tmp2_i32);
         gen_op_mov_reg_v(s, ot, R_EAX, s->T1);
         gen_bpt_io(s, s->tmp2_i32, ot);
-        if (tb_cflags(s->base.tb) & CF_USE_ICOUNT) {
-            gen_jmp(s, s->pc - s->cs_base);
-        }
+        /* A port hook may stop execution. Retire this instruction and
+         * leave the TB before consuming input or changing output registers. */
+        gen_jmp(s, s->pc - s->cs_base);
         break;
     case 0xe6:
     case 0xe7:
@@ -7059,9 +7059,9 @@
         tcg_gen_trunc_tl_i32(tcg_ctx, s->tmp3_i32, s->T1);
         gen_helper_out_func(tcg_ctx, ot, s->tmp2_i32, s->tmp3_i32);
         gen_bpt_io(s, s->tmp2_i32, ot);
-        if (tb_cflags(s->base.tb) & CF_USE_ICOUNT) {
-            gen_jmp(s, s->pc - s->cs_base);
-        }
+        /* A port hook may stop execution. Retire this instruction and
+         * leave the TB before consuming input or changing output registers. */
+        gen_jmp(s, s->pc - s->cs_base);
         break;
     case 0xec:
     case 0xed:
@@ -7076,9 +7076,9 @@
         gen_helper_in_func(tcg_ctx, ot, s->T1, s->tmp2_i32);
         gen_op_mov_reg_v(s, ot, R_EAX, s->T1);
         gen_bpt_io(s, s->tmp2_i32, ot);
-        if (tb_cflags(s->base.tb) & CF_USE_ICOUNT) {
-            gen_jmp(s, s->pc - s->cs_base);
-        }
+        /* A port hook may stop execution. Retire this instruction and
+         * leave the TB before consuming input or changing output registers. */
+        gen_jmp(s, s->pc - s->cs_base);
         break;
     case 0xee:
     case 0xef:
@@ -7095,9 +7095,9 @@
         tcg_gen_trunc_tl_i32(tcg_ctx, s->tmp3_i32, s->T1);
         gen_helper_out_func(tcg_ctx, ot, s->tmp2_i32, s->tmp3_i32);
         gen_bpt_io(s, s->tmp2_i32, ot);
-        if (tb_cflags(s->base.tb) & CF_USE_ICOUNT) {
-            gen_jmp(s, s->pc - s->cs_base);
-        }
+        /* A port hook may stop execution. Retire this instruction and
+         * leave the TB before consuming input or changing output registers. */
+        gen_jmp(s, s->pc - s->cs_base);
         break;
 
