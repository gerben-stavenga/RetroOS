# Sound Blaster completion-protocol probes (see the .asm headers). SBTEST
# runs in CI (test/hosted_games.sh); SBDOOR is a manual stream-continuity
# tool whose real-time phases are too slow for the TCG engine.
genrule(
    name = "sbtest_com",
    srcs = ["sbtest.asm"],
    outs = ["SBTEST.COM"],
    cmd = "nasm -f bin -o $@ $<",
    visibility = ["//visibility:public"],
)

# Discovery/init conformance: version query, mixer, IRQ status/ack, trigger
# IRQ, test register, auto-init block. One marker per behavior, written to
# the screen and to C:\\SBDISC.LOG so a GUI-only backend (86Box, the
# faithful SB16 reference) can be asserted on too.
genrule(
    name = "sbdisc_com",
    srcs = ["sbdisc.asm"],
    outs = ["SBDISC.COM"],
    cmd = "nasm -f bin -o $@ $<",
    visibility = ["//visibility:public"],
)

# Sustained completion-IRQ probe: auto-init DMA, count the interrupts, and
# distinguish "none at all" from "the first one only". The polled probes above
# cannot see either failure. Runs on the real card (86Box sweep) and on the
# emulated one (test/hosted_games.sh).
genrule(
    name = "sbirq_com",
    srcs = ["sbirq.asm"],
    outs = ["SBIRQ.COM"],
    cmd = "nasm -f bin -o $@ $<",
    visibility = ["//visibility:public"],
)

genrule(
    name = "sbdoor_com",
    srcs = ["sbdoor.asm"],
    outs = ["SBDOOR.COM"],
    cmd = "nasm -f bin -o $@ $<",
    visibility = ["//visibility:public"],
)
