# Build lib crate using rules_rust
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_proc_macro", "rust_test")
load("//toolchain:panic.bzl", "panic_strategy")

package(default_visibility = ["//visibility:public"])

# Compact, allocation-free formatting. The host-built proc macro compiles
# format literals to bytecode; the target runtime is an independent no_std
# crate with its own small writer and primitive conversion routines.
rust_proc_macro(
    name = "compact_fmt_macros",
    srcs = ["compact_fmt/macros/src/lib.rs"],
    crate_name = "compact_fmt_macros",
    crate_root = "compact_fmt/macros/src/lib.rs",
    edition = "2024",
)

rust_library(
    name = "compact_fmt",
    srcs = ["compact_fmt/src/lib.rs"],
    crate_name = "compact_fmt",
    crate_root = "compact_fmt/src/lib.rs",
    edition = "2024",
    rustc_flags = [
        "-Crelocation-model=static",
    ] + panic_strategy(),
    proc_macro_deps = [":compact_fmt_macros"],
)

rust_test(
    name = "compact_fmt_test",
    srcs = ["compact_fmt/tests/format.rs"],
    crate_name = "compact_fmt_test",
    edition = "2024",
    rustc_flags = [
        "-Cpanic=abort",
        "-Zpanic_abort_tests",
        "-Crelocation-model=static",
    ],
    deps = [":compact_fmt"],
)

rust_library(
    name = "lib",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "lib",
    edition = "2024",
    rustc_flags = [
        "-Crelocation-model=static",
    ] + panic_strategy(),
    deps = ["//klog", ":compact_fmt"],
)

rust_test(
    name = "vga_test",
    srcs = ["tests/vga.rs"],
    crate_name = "vga_test",
    edition = "2024",
    rustc_flags = [
        "-Cpanic=abort",
        "-Zpanic_abort_tests",
        "-Crelocation-model=static",
    ],
    deps = [":lib", ":vga"],
)

# The VGA: registers, plane ALU, DAC, card state, port model and scanout.
# Its own target rather than part of :lib because it allocates — and it can
# be, because nothing outside the kernel wants a VGA. The bootloader and the
# arch backends link :lib for the text console (:lib stays allocation-free);
# only the kernel links this.
rust_library(
    name = "vga",
    srcs = glob(["vga/src/**/*.rs"]),
    crate_name = "vga",
    crate_root = "vga/src/lib.rs",
    edition = "2024",
    rustc_flags = [
        "-Crelocation-model=static",
    ] + panic_strategy(),
    deps = [":lib"],
)

# Emulated sound cards as passive, host-agnostic state machines, plus the
# integer voice engine they share (GUS now; GM/SF2, AWE32, MT-32 later).
# Its own target, not part of :lib. The per-frame mix loop runs at up to
# 44.1 kHz × 32 voices; metal underrun measurements require speed optimization.
rust_library(
    name = "sound",
    srcs = glob(["sound/src/**/*.rs"]),
    crate_name = "sound",
    crate_root = "sound/src/lib.rs",
    edition = "2024",
    rustc_flags = [
        "-Copt-level=2",
        "-Crelocation-model=static",
    ] + panic_strategy(),
    deps = ["@nuked_opl3//:nuked_opl3"],
)

# Host unit tests (bazelisk test //lib:sound_test --platforms=@platforms//host).
# The crate is cfg_attr(not(test), no_std), so the test build links std and
# the harness; abort matches the rlib (arch-interp test pattern).
rust_test(
    name = "sound_test",
    crate = ":sound",
    # One real .PAT is compiled into the test: the synthetic fixtures only
    # prove the parser agrees with our own idea of the layout.
    compile_data = ["//:apps/ultrasnd/MIDI/acpiano.pat"],
    rustc_flags = [
        "-Cpanic=abort",
        "-Zpanic_abort_tests",
        "-Crelocation-model=static",
    ],
)
